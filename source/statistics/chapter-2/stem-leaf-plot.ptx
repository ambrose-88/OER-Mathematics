            </row>
            <row>
              <cell>5.74</cell>
              <cell>5.81</cell>
              <cell>5.71</cell>
            </row>
            <row>
              <cell>5.93</cell>
              <cell>6.02</cell>
              <cell>5.90</cell>
            </row>
            <row>
              <cell>6.14</cell>
              <cell>6.24</cell>
              <cell>6.11</cell>
            </row>
            <row>
              <cell>6.68</cell>
