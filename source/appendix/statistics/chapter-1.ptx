            <cell>$2,650</cell>
          </row>
          <row>
            <cell>Nissan Cube</cell>
            <cell>Station Wagon</cell>
            <cell>Manual</cell>
            <cell>4</cell>
            <cell>25</cell>
            <cell>30</cell>
            <cell>$1,850</cell>
          </row>
          <row>
            <cell>Ford Fusion</cell>
            <cell>Midsize</cell>
