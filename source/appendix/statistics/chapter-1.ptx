            <cell>Highway MPG</cell>
            <cell>Annual Fuel Cost</cell>
          </row>
          <row>
            <cell>Chevrolet Corvette</cell>
            <cell>Two-Seater</cell>
            <cell>Manual</cell>
            <cell>8</cell>
            <cell>17</cell>
