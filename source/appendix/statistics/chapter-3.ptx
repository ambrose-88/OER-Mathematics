<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="appendix-statistics-chapter-3" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Chapter 3 Lecture Notes</title>

    <definition xml:id="appendix-statistics-ch3-mean-definition">
      <title>Mean</title>
      <statement>
        <p>
          The <term>mean</term>, also called the <term>average</term>, is the sum of all data values divided by the number of values.
        </p>
        <p><em>Population Mean:</em> <m>\mu=\dfrac{\sum x}{N}</m></p>
        <p><em>Sample Mean:</em> <m>\overline{x}=\dfrac{\sum x}{n}</m></p>
      </statement>
    </definition>

    <definition xml:id="appendix-statistics-ch3-mean-symbols">
      <title>What do these symbols mean?</title>
      <statement>
        <p>
          <ul>
            <li><m>\sum</m> means sum or add all values.</li>
            <li><m>x</m> represents individual data values.</li>
            <li><m>N</m> is population size.</li>
            <li><m>n</m> is sample size.</li>
          </ul>
        </p>
      </statement>
    </definition>

    <definition xml:id="appendix-statistics-ch3-mean-two-formulas">
      <title>Why do we have two formulas for mean?</title>
      <statement>
        <p>
          We use one formula for populations and one for samples because they represent different contexts and notations.
        </p>
      </statement>
    </definition>

    <example xml:id="appendix-statistics-ch3-mean-example-1">
      <title>Example 1</title>
      <statement>
        <p>
          Consider exam scores: 75, 80, 85, 90, 95. Calculate the average score.
        </p>
        <table xml:id="appendix-statistics-ch3-mean-table-1">
          <title>Test Scores of Five Students</title>
          <tabular>
            <row header="yes"><cell>Score</cell></row>
            <row><cell>75</cell></row>
            <row><cell>80</cell></row>
            <row><cell>85</cell></row>
            <row><cell>90</cell></row>
            <row bottom="major"><cell>95</cell></row>
          </tabular>
        </table>
      </statement>
    </example>

