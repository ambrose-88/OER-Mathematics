            <row><cell>Exam 1</cell><cell>92%</cell><cell>20%</cell></row>
            <row><cell>Exam 2</cell><cell>67%</cell><cell>20%</cell></row>
            <row bottom="major"><cell>Exam 3</cell><cell>76%</cell><cell>20%</cell></row>
          </tabular>
        </table>
      </statement>
    </example>

